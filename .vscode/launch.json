{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "STM32F407: build + flash + debug (ST-LINK)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/firmware.elf",
            "configFiles": ["interface/stlink.cfg", "target/stm32f4x.cfg"],
            // ST's register descriptions: the Peripherals view shows every register by name.
            "svdFile": "${workspaceFolder}/third_party/svd/STM32F407.svd",
            "runToEntryPoint": "main",
            "preLaunchTask": "make firmware"
        },
        {
            "name": "STM32F407: attach to running target (ST-LINK)",
            "type": "cortex-debug",
            "request": "attach",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/firmware.elf",
            "configFiles": ["interface/stlink.cfg", "target/stm32f4x.cfg"],
            "svdFile": "${workspaceFolder}/third_party/svd/STM32F407.svd"
        },
        {
            // PC-side: compile the open .c file and debug it with MSYS2 gdb.
            "name": "Debug current C file (PC)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/msys64/clang64/bin/gdb.exe",
            "externalConsole": false,
            "stopAtEntry": false,
            "setupCommands": [
                { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
            ],
            "preLaunchTask": "build current C file"
        }
    ]
}
